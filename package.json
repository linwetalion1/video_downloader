{
  "name": "image-downloader-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Edge MV3 extension: search, preview, filter and bulk-download images from web pages",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:chrome-macos": "npm run --prefix video-downloader-explorer package:chrome-macos",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fflate": "^0.8.3",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.2"
  }
}
